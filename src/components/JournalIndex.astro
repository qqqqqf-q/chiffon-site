---
// journal 索引页(EN /journal/、ZH /zh/journal/ 共用)。左对齐标题 + 两列纸面色块卡片。
// 没有封面图,卡片只放标题、两行描述和日期。
// 卡片无描边,常态纯白(比页面亮),hover 微暗一档,按下再暗一档;状态切换无过渡,即时反馈,不浮起不冒箭头。
// 界面文字按全站语言策略固定英文;只有文章标题/描述随语言切换。
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from './SiteHeader.astro';
import SiteFooter from './SiteFooter.astro';
import { buildJournalIndexJsonLd } from '../lib/schema';
import { absoluteUrl } from '../config/site';
import { getJournal, journalIndexHref, journalPostHref, type Lang } from '../lib/journal';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const items = await getJournal(lang);
const indexPath = journalIndexHref(lang);
const altLang: Lang = lang === 'zh' ? 'en' : 'zh';

// timeZone 锁 UTC:frontmatter 的纯日期按 UTC 午夜解析,不锁的话西半球读者会看到前一天。
const fmt = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
});

const alternates = [
  { hreflang: 'en', href: absoluteUrl(journalIndexHref('en')) },
  { hreflang: 'zh-CN', href: absoluteUrl(journalIndexHref('zh')) },
  { hreflang: 'x-default', href: absoluteUrl(journalIndexHref('en')) },
];

const jsonLd = buildJournalIndexJsonLd(
  items.map(({ slug, post }) => ({
    href: journalPostHref(lang, slug),
    title: post.data.title,
    description: post.data.description,
    date: post.data.date,
    lang: post.data.lang,
  })),
  indexPath,
);
---


<BaseLayout
  title="Journal · Chiffonwind (清凤)"
  description="Technical notes and experiments on AI agents, LLM engineering, and interface design by Chiffonwind (清凤)."
  lang={lang === 'zh' ? 'zh-CN' : 'en'}
  canonicalPath={indexPath}
  alternates={alternates}
  jsonLd={jsonLd}
>
  <SiteHeader lang={lang} current="journal" altHref={journalIndexHref(altLang)} />

  <main>
    <!-- 页头只留标题和一句说明:顶栏已标出当前在 Journal,面包屑重复,删掉。
         标题与下方网格共用 max-w-5xl 版心线。 -->
    <section class="mx-auto max-w-5xl px-6 pt-16 pb-10">
      <h1 class="font-display text-head text-4xl sm:text-5xl font-[450] tracking-tight">Journal</h1>
      <p class="text-dim text-[15px] mt-3">Notes on AI agents, engineering, and product design.</p>
    </section>

    <!-- 卡片网格:单列保底,sm 起两列。中文长标题在三列下会挤成三四行,
         两列让标题基本两行内读完。卡片是纯色块(无描边),靠底色与页面分层;
         浅色下比页面亮一档,深色下是零彩度高一档。
         内容只有三层:标题 → 两行描述 → 日期,mt-auto 把日期压到卡底。
         tags 不在列表上展示(文章页里有),列表只负责让人挑出想读的一篇。 -->
    <section class="mx-auto max-w-5xl px-6 pb-24">
      {items.length === 0 ? (
        <p class="py-16 text-fade text-[15px]">No posts yet.</p>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {items.map(({ slug, post, fallback }) => {
            return (
              <a
                href={journalPostHref(lang, slug)}
                class="paper-card group flex flex-col rounded-[var(--radius-section)] bg-paper p-6 sm:p-7 hover:bg-paper-hover active:bg-paper-active"
              >
                <h2 class="font-display text-[19px] font-[450] leading-snug text-head">
                  {post.data.title}
                </h2>

                <p class="mt-3 text-[14px] leading-relaxed text-dim line-clamp-2">
                  {post.data.description}
                </p>

                {/* 回落文章(当前语言没有这一篇)在日期后标出原文语言,点进去前就知道读的是哪种语言 */}
                <p class="mt-auto pt-6 text-[13px] text-fade tabular-nums">
                  <time datetime={post.data.date.toISOString()}>{fmt.format(post.data.date)}</time>
                  {fallback && <span lang={post.data.lang}> · {post.data.lang === 'en' ? 'English' : '中文'}</span>}
                </p>
              </a>
            );
          })}
        </div>
      )}
    </section>
  </main>


  <SiteFooter projectsTitle="Projects" siteTitle="Site" aboutLabel="About" journalLabel="Journal" lang={lang} altHref={journalIndexHref(altLang)} />
</BaseLayout>

---
import '../styles/global.css';
import { AUTHOR, DEFAULT_OG_IMAGE, SITE_NAME, SITE_URL, absoluteUrl } from '../config/site';

export interface AlternateLink {
  hreflang: string;
  href: string;
}

export interface ArticleMeta {
  publishedTime: string;
  modifiedTime?: string;
  author?: string;
  tags?: string[];
}

interface Props {
  title: string;
  description?: string;
  lang?: string;
  canonicalPath?: string;
  alternates?: AlternateLink[];
  ogType?: 'website' | 'profile' | 'article';
  ogImage?: string;
  ogImageAlt?: string;
  noindex?: boolean;
  articleMeta?: ArticleMeta;
  jsonLd?: Record<string, unknown>;
}

const {
  title,
  description = AUTHOR.descriptionEn,
  lang = 'en',
  canonicalPath,
  alternates = [],
  ogType = 'website',
  ogImage = DEFAULT_OG_IMAGE,
  ogImageAlt = `${SITE_NAME} — ${AUTHOR.jobTitle}`,
  noindex = false,
  articleMeta,
  jsonLd,
} = Astro.props;

const canonicalUrl = absoluteUrl(canonicalPath ?? Astro.url.pathname);
const ogImageUrl = absoluteUrl(ogImage);
const ogLocale = lang.toLowerCase().startsWith('zh') ? 'zh_CN' : 'en_US';
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, '\\u003c') : '';
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={AUTHOR.displayName} />
    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <link rel="canonical" href={canonicalUrl} />
    )}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${SITE_NAME} · Journal`}
      href={absoluteUrl('/rss.xml')}
    />
    <link rel="author" href={`${SITE_URL}/`} />

    <!-- Open Graph -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    {articleMeta && (
      <>
        <meta property="article:published_time" content={articleMeta.publishedTime} />
        {articleMeta.modifiedTime && (
          <meta property="article:modified_time" content={articleMeta.modifiedTime} />
        )}
        <meta property="article:author" content={articleMeta.author ?? `${SITE_URL}/`} />
        {(articleMeta.tags ?? []).map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}

    <!-- Twitter / X Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content={AUTHOR.xHandle} />
    <meta name="twitter:creator" content={AUTHOR.xHandle} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- favicon:文件名带 v2,以后换图递增版本号——浏览器对 favicon 的
         缓存极顽固(尤其域名换过站),不换 URL 不会重新拉取 -->
    <link rel="icon" type="image/png" href="/icon-192.png?v=2" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&display=swap"
      rel="stylesheet"
    />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <!-- 主题只跟随系统（不提供手动切换）；head 内联执行避免 FOUC。
         .dark class 同时驱动 Terra tokens（global.css）和 felinic 组件库的深色变体。 -->
    <script is:inline>
      const mq = window.matchMedia('(prefers-color-scheme: dark)');
      const applyTheme = () => document.documentElement.classList.toggle('dark', mq.matches);
      applyTheme();
      mq.addEventListener('change', applyTheme);
    </script>
  </head>
  <body class="min-h-screen bg-surface">
    <slot />
  </body>
</html>
